                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "22. Delete role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "roles",
                "3"
              ]
            },
            "description": "Admin only. Not allowed for admin/user or a role assigned to users."
          }
        }
      ]
    }
  ]
}