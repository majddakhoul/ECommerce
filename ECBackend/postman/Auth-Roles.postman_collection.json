              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/roles/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "roles",
                "3"
              ]
            },
            "description": "Admin only. admin and user cannot be renamed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"reviewer\"\n}",
